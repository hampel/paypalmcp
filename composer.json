{
    "name": "hampel/paypalmcp",
    "description": "Read-only MCP server over stdio for questions about PayPal transactions, balances and subscriptions, held to a daily request budget per account.",
    "keywords": [
        "paypal",
        "transactions",
        "mcp",
        "model context protocol",
        "console",
        "cli"
    ],
    "homepage": "https://github.com/hampel/paypalmcp",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/hampel/paypalmcp/issues",
        "source": "https://github.com/hampel/paypalmcp"
    },
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8",
        "hampel/console-report": "^2.2",
        "hampel/paypal-api": "^0.2",
        "hampel/paypal-api-laravel": "^0.1",
        "illuminate/http": "^13.0",
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0",
        "laravel/mcp": "^1.0",
        "php-collective/toml": "^0.1.5"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.7.8",
        "phpstan/phpstan": "^2.1.22"
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "check": [
            "@analyse",
            "@test"
        ],
        "build": [
            "@composer install --no-dev --no-interaction",
            "@php paypalmcp app:build paypalmcp",
            "@composer install --no-interaction",
            "if grep -aq 'vendor/laravel/pint/' builds/paypalmcp; then echo 'ERROR: the build contains dev dependencies - do not release it'; exit 1; fi"
        ]
    },
    "scripts-descriptions": {
        "build": "Compile the phar without dev dependencies, then restore them",
        "analyse": "Static analysis at the level phpstan.neon records",
        "check": "Everything a change should pass before it is committed"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "paypalmcp"
    ]
}
