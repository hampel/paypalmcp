# Template for the account inventory: the PayPal business accounts this server may read, and a
# REST app for each. Copy it to the state directory as accounts.toml, or point
# PAYPALMCP_ACCOUNTS_PATH at it. `paypalmcp app:validate` checks every entry, and asks PayPal
# whether each app can do what the tools need.
#
# THE LIVE FILE HOLDS A CLIENT SECRET FOR EVERY ACCOUNT, and each secret's token can do anything
# the app may, refunds and payouts included. Keep it out of any repository and make it 0600, or
# root-owned and 0640 for a group of the user that runs the server; `app:validate` fails anything
# wider.

# The key - `acme` here - is lowercase letters and digits, and is the `account` every tool takes.
[acme]
name = "Acme Example Pty Ltd"

# "live" for a real account, "sandbox" for PayPal's test system. Required: a live app is refused
# by the sandbox host and the other way round, and the mistake that does not fail loudly is the
# one that reads real payers when you meant to test.
environment = "sandbox"

# Requests this server may send to this account in any 24 hours. Optional; the default is
# PAYPALMCP_DAILY_BUDGET, or 500. Three years of transaction history is about 37 requests.
# daily_budget = 500

# A REST app made for this server alone, from the Apps & Credentials page of PayPal's developer
# dashboard, with Transaction Search and Subscriptions ticked and nothing else - so it can be
# revoked without touching anything else and its token is its own. Leave both lines out until the account has one: the account is then
# listed, and every call to it refused.
client_id = "AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
secret = "EXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
